  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "buffer_font_family": "Fira Code",
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "single_file_review": true,
    "commit_message_model": {
      "provider": "lmstudio",
      "model": "default",
    },
    "thread_summary_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
    },
