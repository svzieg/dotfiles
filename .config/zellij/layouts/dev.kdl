// "dev" layout: nvim (main) + shell split, with the zjstatus bar.
// Used by ~/.local/bin/sess for repo sessions. cwd is inherited from the
// dir `sess` cd'd into before launching.
// NOTE: the zjstatus block below is kept in sync with tmux.kdl by hand.
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode} #[fg=#89b4fa,bg=#1e1e2e,bold] {session} #[default]{tabs}"
                format_center ""
                format_right  "#[fg=#cba6f7,bg=#1e1e2e]#[fg=#1e1e2e,bg=#cba6f7,bold] {datetime} "
                format_space  "#[bg=#1e1e2e]"

                mode_normal     "#[bg=#a6e3a1,fg=#1e1e2e,bold] NORMAL #[bg=#1e1e2e,fg=#a6e3a1]"
                mode_locked     "#[bg=#f38ba8,fg=#1e1e2e,bold] LOCKED #[bg=#1e1e2e,fg=#f38ba8]"
                mode_tmux       "#[bg=#fab387,fg=#1e1e2e,bold] TMUX #[bg=#1e1e2e,fg=#fab387]"
                mode_pane       "#[bg=#89b4fa,fg=#1e1e2e,bold] PANE #[bg=#1e1e2e,fg=#89b4fa]"
                mode_tab        "#[bg=#89b4fa,fg=#1e1e2e,bold] TAB #[bg=#1e1e2e,fg=#89b4fa]"
                mode_resize     "#[bg=#f9e2af,fg=#1e1e2e,bold] RESIZE #[bg=#1e1e2e,fg=#f9e2af]"
                mode_move       "#[bg=#f9e2af,fg=#1e1e2e,bold] MOVE #[bg=#1e1e2e,fg=#f9e2af]"
                mode_scroll     "#[bg=#94e2d5,fg=#1e1e2e,bold] SCROLL #[bg=#1e1e2e,fg=#94e2d5]"
                mode_search     "#[bg=#94e2d5,fg=#1e1e2e,bold] SEARCH #[bg=#1e1e2e,fg=#94e2d5]"
                mode_session    "#[bg=#f5c2e7,fg=#1e1e2e,bold] SESSION #[bg=#1e1e2e,fg=#f5c2e7]"
                mode_renametab  "#[bg=#fab387,fg=#1e1e2e,bold] RENAME #[bg=#1e1e2e,fg=#fab387]"
                mode_renamepane "#[bg=#fab387,fg=#1e1e2e,bold] RENAME #[bg=#1e1e2e,fg=#fab387]"
                mode_default_to_mode "normal"

                tab_normal      "#[fg=#6c7086,bg=#1e1e2e] {index} {name} "
                tab_active      "#[fg=#1e1e2e,bg=#cba6f7,bold] {index} {name} "
                tab_separator   "#[bg=#1e1e2e] "
                tab_sync_active "#[fg=#1e1e2e,bg=#94e2d5,bold] {index} {name} <> "

                command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format      "#[fg=blue] {stdout} "
                command_git_branch_interval    "10"
                command_git_branch_rendermode  "static"

                datetime          "{format}"
                datetime_format   "%a %d %b  %H:%M"
                datetime_timezone "Europe/Berlin"
            }
        }
    }
    // nvim main (top, 80%) + shell (bottom).
    // Flip split_direction to "vertical" if you want them side-by-side.
    tab name="code" focus=true {
        pane split_direction="horizontal" {
            pane command="nvim" size="80%"
            pane
        }
    }
}
