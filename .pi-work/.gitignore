# Secrets — NEVER commit
agent/auth.json
agent/models-store.json
agent/trust.json
# NOTE: agent/models.json IS tracked on purpose. It holds provider endpoints that
# reference credentials as $ENV_VAR, never literal keys, and other machines need it
# to reproduce the Langdock setup.

