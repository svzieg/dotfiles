{
  "lastChangelogVersion": "0.80.2",
  "defaultProvider": "neuralwatt",
  "defaultModel": "glm-5.2-short",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:context-mode",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:pi-intercom",
    "npm:pi-web-access",
    "npm:pi-simplify",
    "npm:pi-lens",
    "npm:pi-caveman",
    "npm:pi-rtk-rewrite",
    "npm:@aliou/pi-neuralwatt",
    "npm:pi-puppeteer"
  ],
  "enabledModels": [
    "neuralwatt/glm-5.2",
    "neuralwatt/glm-5.2-short",
    "neuralwatt/kimi-k2.7-code"
  ],
  "hideThinkingBlock": false,
  "steeringMode": "one-at-a-time",
  "subagents": {
    "agentOverrides": {
      "worker": {
        "thinking": "medium",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "ctx_execute",
          "ctx_execute_file",
          "ctx_search",
          "ctx_index",
          "ctx_fetch_and_index",
          "ctx_batch_execute",
          "mcp"
        ]
      },
      "scout": {
        "thinking": "low",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "ctx_execute",
          "ctx_search",
          "ctx_fetch_and_index",
          "web_search"
        ]
      },
      "reviewer": {
        "thinking": "high",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "ctx_execute",
          "ctx_search",
          "mcp"
        ]
      },
      "delegate": {
        "thinking": "medium",
        "tools": [
          "read",
          "ctx_execute",
          "ctx_search",
          "mcp"
        ]
      },
      "oracle": {
        "thinking": "high",
        "tools": [
          "read",
          "ctx_search",
          "intercom",
          "ctx_execute"
        ]
      },
      "planner": {
        "thinking": "high",
        "tools": [
          "read",
          "write",
          "ctx_search",
          "ctx_execute_file"
        ]
      },
      "context-builder": {
        "thinking": "medium",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "web_search",
          "ctx_execute",
          "ctx_search",
          "ctx_fetch_and_index",
          "ctx_batch_execute"
        ]
      },
      "researcher": {
        "thinking": "high",
        "tools": [
          "read",
          "web_search",
          "fetch_content",
          "get_search_content",
          "ctx_execute",
          "ctx_execute_file",
          "ctx_search",
          "ctx_fetch_and_index",
          "ctx_batch_execute"
        ]
      }
    }
  },
  "theme": "dark"
}