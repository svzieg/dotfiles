#!/bin/sh
# Keep package executables local to the selected Pi profile, including MCP servers.
pi_profile=${PI_CODING_AGENT_DIR:-"$HOME/.pi/agent"}
pi_package_bin=$pi_profile/npm/node_modules/.bin
pi_clean_path=:${PATH-}:
# Also remove entries inherited from shells that sourced the old pi-paths.sh.
for pi_old_bin in "$HOME/.pi/agent/npm/node_modules/.bin" "$HOME/.pi-work/agent/npm/node_modules/.bin" "$pi_package_bin"; do
  while :; do
    case "$pi_clean_path" in
      *":$pi_old_bin:"*)
        pi_clean_path=${pi_clean_path%%":$pi_old_bin:"*}:${pi_clean_path#*":$pi_old_bin:"}
        ;;
      *) break ;;
    esac
  done
done
pi_clean_path=${pi_clean_path#:}
pi_clean_path=${pi_clean_path%:}

# Use PATH order, skipping our wrapper directory and any aliases of this script.
# The managed installer can also put Pi in ~/.pi/agent/bin without adding it to PATH.
pi_search_path=$pi_clean_path:$HOME/.pi/agent/bin:
while [ -n "$pi_search_path" ]; do
  pi_dir=${pi_search_path%%:*}
  pi_search_path=${pi_search_path#*:}
  [ -n "$pi_dir" ] && [ ! "$pi_dir" -ef "$HOME/.local/bin" ] || continue
  pi_candidate=$pi_dir/pi
  if [ -f "$pi_candidate" ] && [ -x "$pi_candidate" ] && [ ! "$pi_candidate" -ef "$0" ]; then
    PATH=$pi_package_bin:$pi_clean_path
    export PATH
    exec "$pi_candidate" "$@"
  fi
done

printf '%s\n' 'pi: no executable found on PATH outside ~/.local/bin or in ~/.pi/agent/bin' >&2
exit 127
