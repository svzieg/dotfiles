#!/usr/bin/env bash
# Fuzzy session-izer for herdr.
# Pick a local repo (under $CODING_ROOT) or an SSH host (~/.ssh/config)
# -> create-or-focus a herdr WORKSPACE for it inside the current herdr
# session, instead of starting a separate herdr session per project.
# herdr already supports many workspaces in one persistent session (and a
# plain `herdr` from any terminal attaches to that same session), so that's
# the natural unit here, not a new session/window per pick.
#   repo  -> nvim + shell split
#   ssh   -> plain shell running `ssh <host>`
set -uo pipefail

# Launched from a KDE shortcut -> minimal PATH (no linuxbrew, maybe no ~/.local/bin).
export PATH="$HOME/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

SESS_LOG="/tmp/sess.log"
{ echo "===== sess start $(date) PATH=$PATH"; } >>"$SESS_LOG" 2>&1
exec 2> >(tee -a "$SESS_LOG" >&2)

# keep the terminal open so errors are readable instead of vanishing
die() { echo "ERROR: $*" | tee -a "$SESS_LOG" >&2; echo; read -r -p "press enter to close..." _; exit 1; }

CODING_ROOT="${CODING_ROOT:-$HOME/coding}"
HERDR_BIN="$(command -v herdr)"
[ -z "$HERDR_BIN" ] && die "herdr not found in PATH"
command -v fzf >/dev/null 2>&1 || die "fzf not found in PATH"
command -v jq >/dev/null 2>&1 || die "jq not found in PATH"

sanitize() { printf '%s' "$1" | tr -c 'a-zA-Z0-9_.-' '_'; }

list_targets() {
  # local repos: parent dirs of .git under CODING_ROOT
  if command -v fd >/dev/null 2>&1; then
    fd -t d -H -g '.git' "$CODING_ROOT" 2>/dev/null | sed 's,/\.git/\?$,,'
  else
    find "$CODING_ROOT" -maxdepth 4 -type d -name .git 2>/dev/null | sed 's,/.git$,,'
  fi | sort -u | sed 's,^,repo\t,'
  # ssh hosts (skip wildcard patterns)
  if [ -f "$HOME/.ssh/config" ]; then
    awk 'tolower($1)=="host"{for(i=2;i<=NF;i++) if($i!~/[*?]/ && $i!="") print "ssh\t"$i}' \
      "$HOME/.ssh/config" | sort -u
  fi
}

# fzf: show kind + nice label, hide the raw path column from matching noise
sel=$(list_targets | fzf \
        --delimiter='\t' --with-nth='1,2' \
        --prompt='session> ' --height='70%' --reverse --border \
        --header='enter: open session   esc: cancel' \
        --preview 'k={1}; t={2}; if [ "$k" = repo ]; then git -C "$t" log --oneline -10 2>/dev/null || ls -la "$t"; else echo "ssh -> $t"; fi') || exit 0
[ -z "$sel" ] && exit 0

kind=$(printf '%s' "$sel" | cut -f1)
target=$(printf '%s' "$sel" | cut -f2)
echo "selected: kind=$kind target=$target" >>"$SESS_LOG"

case "$kind" in
  repo)
    name="$(sanitize "$(basename "$target")")"
    cwd="$target"
    cmd='herdr pane split --current --direction down --ratio 0.8 --cwd "$PWD" --no-focus && exec nvim'
    ;;
  ssh)
    name="ssh_$(sanitize "$target")"
    cwd="$HOME"
    cmd="ssh $target"
    ;;
  *)
    die "unknown selection: $sel"
    ;;
esac

# Make sure a server is reachable, starting a headless one if this is a
# true cold start (nothing running yet, e.g. right after login/reboot).
# herdr restores its previous workspaces when the server comes up (see
# session.json / resume_agents_on_restore), so cold start is otherwise
# identical to the warm case below -- it must go through the same
# label-match-or-create check instead of blindly creating a duplicate.
if ! "$HERDR_BIN" workspace list >/dev/null 2>&1; then
  [ -n "${HERDR_ENV:-}" ] && die "no herdr server reachable, but already inside a herdr pane -- can't bootstrap from here"
  echo "no herdr server reachable, starting one" >>"$SESS_LOG"
  setsid "$HERDR_BIN" server >/dev/null 2>&1 &
  disown
  up=0
  for _ in $(seq 1 30); do
    sleep 0.5
    "$HERDR_BIN" workspace list >/dev/null 2>&1 && { up=1; break; }
  done
  [ "$up" = 1 ] || die "herdr server did not come up"
fi

# `workspace create`'s --env is scoped to just this one pane spawn (unlike
# `herdr --session`'s env, which becomes the server's own permanent environ
# -- see ~/.zshrc), so no SESS_CMD/hook indirection is needed: just type
# the setup command straight into the fresh pane.
ws_list=$("$HERDR_BIN" workspace list 2>/dev/null) || die "herdr workspace list failed"
ws_id=$(printf '%s' "$ws_list" | jq -r --arg n "$name" \
  '.result.workspaces[]? | select(.label == $n) | .workspace_id' | head -1)

if [ -n "$ws_id" ]; then
  echo "reusing workspace $ws_id (label=$name)" >>"$SESS_LOG"
  "$HERDR_BIN" workspace focus "$ws_id" || die "herdr workspace focus failed"
else
  created=$("$HERDR_BIN" workspace create --cwd "$cwd" --label "$name" --focus 2>&1) \
    || die "herdr workspace create failed: $created"
  root_pane=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')
  [ -z "$root_pane" ] && die "herdr workspace create: no root pane in response: $created"
  echo "created workspace for $name, pane=$root_pane, seeding: $cmd" >>"$SESS_LOG"
  sleep 1.5   # let the fresh shell clear its startup banner before we type into it
  "$HERDR_BIN" pane send-text "$root_pane" "$cmd"
  "$HERDR_BIN" pane send-keys "$root_pane" enter
fi

if [ -n "${HERDR_ENV:-}" ]; then
  echo "Already inside herdr -- workspace '$name' is focused; switch to it with the workspace picker (Ctrl-b w)." >&2
  exit 0
fi
exec "$HERDR_BIN"   # attach a client to the (now-focused) session
