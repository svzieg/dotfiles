#!/usr/bin/env bash
# Download zellij plugins manually (sequential) to avoid zellij bug #3479
# (concurrent tab downloads corrupt the wasm).
# Re-run any time to update to latest releases.
set -uo pipefail

PLUGIN_DIR="${HOME}/.config/zellij/plugins"
mkdir -p "$PLUGIN_DIR"

# name|github-release-url
PLUGINS=(
  "zjstatus|https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm"
  "vim-zellij-navigator|https://github.com/hiasr/vim-zellij-navigator/releases/latest/download/vim-zellij-navigator.wasm"
  "zellij-autolock|https://github.com/fresh2dev/zellij-autolock/releases/latest/download/zellij-autolock.wasm"
  "zellij-sessionizer|https://github.com/laperlej/zellij-sessionizer/releases/latest/download/zellij-sessionizer.wasm"
)

# verify first 4 bytes == wasm magic \0asm (0x00 61 73 6d)
is_wasm() {
  local f="$1"
  [ -s "$f" ] || return 1
  local magic
  magic=$(head -c4 "$f" | od -An -tx1 | tr -d ' \n')
  [ "$magic" = "0061736d" ]
}

ok=0; fail=0
for entry in "${PLUGINS[@]}"; do
  name="${entry%%|*}"
  url="${entry#*|}"
  dst="${PLUGIN_DIR}/${name}.wasm"
  tmp="${dst}.tmp"
  printf '== %-22s ' "$name"
  # sequential, follow redirects, retry, fail on http error
  if curl -fsSL --retry 3 --retry-delay 2 -o "$tmp" "$url"; then
    if is_wasm "$tmp"; then
      mv -f "$tmp" "$dst"
      printf 'OK  (%s bytes)\n' "$(stat -c%s "$dst")"
      ok=$((ok+1))
    else
      printf 'FAIL (not a wasm file - corrupt/404)\n'
      rm -f "$tmp"
      fail=$((fail+1))
    fi
  else
    printf 'FAIL (download error)\n'
    rm -f "$tmp"
    fail=$((fail+1))
  fi
done

echo "----"
echo "done: $ok ok, $fail failed  ->  $PLUGIN_DIR"
[ "$fail" -eq 0 ]
